{"file":"index-DDf2SBuM.js","mappings":";;;;;;;;;;;;;;;AAoBA,UAAM,YAAY,IAA8B,IAAI;;;iBAlB5C;AAAA,QAAJ,KAAI;AAAA,QACJ,OAAM;AAAA,QACL,OAAO,EAAA,eAAA,OAAA;AAAA,QACR,eAAY;AAAA,MAAA;;;;;;;;;;;;;;ACiFhB,UAAM,aAAa,IAAI,EAAE;AAUzB,UAAM,aAAa;AAAA,MACjB,EAAE,OAAO,OAAO,OAAO,OAAA;AAAA,MACvB,EAAE,OAAO,QAAQ,OAAO,OAAA;AAAA,MACxB,EAAE,OAAO,OAAO,OAAO,OAAA;AAAA,MACvB,EAAE,OAAO,SAAS,OAAO,OAAA;AAAA,IAAO;;;AAnGvB,YAAA,WAAAA,eAAAC,WAAA,EAAA,OAAM,4EAAwE,MAAA,CAAA,CAAA,GAAA;AAE1E,YAAAC,mBAAA,sBAAA,EAAA,OAAM,sBAAkB,MAAA,OAAA,CAAA;uLAKjC,EAAA,cAAA,wEAAA,CAA0F,+XAUvCC,MAAA,UAAA,CAAU;AA+C1CC,oBAAA,aAAL,MAAC;oIAENC,eAAA,EAAE,KAAK,kDAE+BA,eAAA,EAAE,KAAK;;;;;;;;;;;;;;;;ACrB5D,UAAM,SAAS;AAAA,MACb;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,SAAS;AAAA,UACP;AAAA,UACA;AAAA,UACA;AAAA,QAAA;AAAA,MACF;AAAA,MAEF;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,SAAS;AAAA,UACP;AAAA,UACA;AAAA,UACA;AAAA,QAAA;AAAA,MACF;AAAA,MAEF;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,SAAS;AAAA,UACP;AAAA,UACA;AAAA,UACA;AAAA,QAAA;AAAA,MACF;AAAA,IACF;;AAhFS,YAAA,WAAAL,eAAAC,WAAA,EAAA,OAAM,oBAAgB,MAAA,CAAA,CAAA,8ZAAA;oBAcN,QAAM,CAAf,GAAG,MAAC;4EAIe,IAAC,CAAA,IAAA,8BAAA,CAAA,yEAG2B,IAAC,CAAA;UAIlB,YAAA,EAAE;AAAA;eAKnCI,eAAA,EAAE,IAAI,8CAE4BA,eAAA,EAAE,KAAK,uDACGA,eAAA,EAAE,IAAI;sBAErC,EAAE,SAAO,CAAd,MAAC;+IAED,CAAC,CAAA,cAAA;AAAA;;;;;;;;;;;;;;;;;ACkIxB,UAAM,gBAAgB,IAAmB,IAAI;AAC7C,UAAM,kBAAkB,IAAI,KAAK;AACjC,UAAM,cAAc,IAAI,WAAW;AAChB,QAAI,CAAC;AAkBxB,UAAM,aAAa,IAAI,CAAC;AAQxB,UAAM,WAAW,IAAI,KAAK;AAC1B,UAAM,eAAe,IAAI,KAAK;AAC9B,UAAM,aAAa,SAAS,EAAE,MAAM,IAAI,OAAO,IAAI;AAgBnD,UAAM,aAAa,IAAsD,EAAE;;;QAtNhE,IAAG;AAAA,QAAa,OAAM;AAAA,MAAA,oKAI3B,EAAA,cAAA,uDAAA,CAAyE;UA8BzDF,MAAA,aAAA,GAAa;yGAIhBA,MAAA,aAAA,CAAa,CAAA,QAAA;AAAA;mFAE2BA,MAAA,WAAA,CAAW,CAAA,QAAA;AAAA;oDAKlDA,MAAA,eAAA,0NAGGA,MAAA,eAAA,CAAe,IAAA,cAAA,qCAEvBA,MAAA,eAAA,IAAe,SAAA,OAAA,ipBAkBbA,MAAA,UAAA,CAAU,q3BA2BHA,MAAA,YAAA,IAAY,mBAAA,eAAA,8FAAA,CAAA,aACZG,eAAAH,MAAA,UAAA,EAAW,IAAI;UAKZA,MAAA,YAAA,GAAY;;;;;2CAIfA,MAAA,YAAA,IAAY,mBAAA,eAAA,8FAAA,CAAA,aACZG,eAAAH,MAAA,UAAA,EAAW,KAAK,2EAQpBA,MAAA,QAAA,0NAGGA,MAAA,QAAA,CAAQ,IAAA,cAAA,sBAEhBE,eAAAF,MAAA,QAAA,aAAoBA,MAAA,YAAA,IAAY,SAAA,MAAA;oBAkBhBA,MAAA,UAAA,GAAU,CAAnB,GAAG,MAAC;;UAGuB,MAAA,GAAA,EAAE,CAAC;AAAA,UAA6B,KAAA,GAAA,EAAE,CAAC;AAAA,UAA8B,SAAA,EAAE;AAAA,UAAuC,WAAA,SAAA,EAAE,CAAC;AAAA;;;;AAU7I,YAAA,wFAAAE,eAAAF,MAAA,UAAA,EAAW,MAAM,CAAA,yOAAA;AAAA;;;;;;;;;;AChJ3B,SAAS,WACd,WACA,aAAa,MACb;AACA,QAAM,QAAQ,IAAI,CAAC;AACK,SAAO;AA+CjC;;;;;ACFA,UAAM,UAAoB;AAAA,MACxB,EAAE,OAAO,MAAM,QAAQ,KAAK,OAAO,UAAU,MAAM,YAAA;AAAA,MACnD,EAAE,OAAO,IAAI,QAAQ,MAAM,OAAO,UAAU,MAAM,QAAA;AAAA,MAClD,EAAE,OAAO,KAAO,QAAQ,KAAK,OAAO,UAAU,MAAM,iBAAA;AAAA,MACpD,EAAE,OAAO,IAAI,QAAQ,KAAK,OAAO,SAAS,MAAM,WAAA;AAAA,IAAW;AAI7D,UAAM,KAAK,WAAiC;AAC5C,UAAM,KAAK,WAAiC;AAC5C,UAAM,KAAK,WAAiC;AAC5C,UAAM,KAAK,WAAiC;AAC5C,UAAM,OAAO,CAAC,IAAI,IAAI,IAAI,EAAE;AAE5B,UAAM,eAAe,CAAC,GAAW,MAAc;AAC7C,YAAM,IAAI,KAAK,CAAC,EAAE;AAClB,UAAI,KAAK,IAAM,QAAO,EAAE,eAAA;AACxB,aAAO;AAAA,IACT;AAEA,UAAM,WAAW;AAAA,MACf,EAAE,OAAO,YAAY,OAAO,UAAU,GAAG,IAAI,OAAO,2CAAA;AAAA,MACpD,EAAE,OAAO,kBAAkB,OAAO,WAAW,GAAG,IAAI,OAAO,2CAAA;AAAA,MAC3D,EAAE,OAAO,UAAU,OAAO,UAAU,GAAG,IAAI,OAAO,2CAAA;AAAA,MAClD,EAAE,OAAO,iBAAiB,OAAO,UAAU,GAAG,KAAK,OAAO,2CAAA;AAAA,IAA2C;;AAhF5F,YAAA,WAAAH,eAAAC,WAAA,EAAA,OAAM,oBAAgB,MAAA,CAAA,CAAA,mbAAA;oBAcN,SAAO,CAAhB,GAAG,MAAC;4EAIgB,IAAC,IAAA,CAAA,IAAA,oCAAA,CAAA,kGAGxB,aAAa,GAAG,CAAC,CAAA,IAAOI,eAAA,EAAE,MAAM,6CAECA,eAAA,EAAE,KAAK,kDACFA,eAAA,EAAE,IAAI;;;AAQ9BD,oBAAA,WAAP,QAAG;iGAEoBC,eAAA,IAAI,KAAK,gEACgBA,eAAA,IAAI,KAAK;UAK5B,OAAA,IAAI,IAAC;AAAA,UAAsC,YAAA,IAAI;AAAA,UAAgD,WAAA,YAAA,IAAI,KAAK;AAAA,QAAA;;;;;;;;;;;;;;;;ACc3J,UAAM,YAAY;AAAA,MAChB;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,KAAK;AAAA,QACL,MAAM;AAAA,QACN,MAAM,CAAC,MAAM,MAAM,IAAI;AAAA,MAAA;AAAA,MAEzB;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,KAAK;AAAA,QACL,MAAM;AAAA,QACN,MAAM,CAAC,MAAM,MAAM,KAAK;AAAA,MAAA;AAAA,MAE1B;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,KAAK;AAAA,QACL,MAAM;AAAA,QACN,MAAM,CAAC,MAAM,MAAM,IAAI;AAAA,MAAA;AAAA,MAEzB;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,KAAK;AAAA,QACL,MAAM;AAAA,QACN,MAAM,CAAC,MAAM,MAAM,IAAI;AAAA,MAAA;AAAA,MAEzB;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,KAAK;AAAA,QACL,MAAM;AAAA,QACN,MAAM,CAAC,MAAM,MAAM,IAAI;AAAA,MAAA;AAAA,MAEzB;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,KAAK;AAAA,QACL,MAAM;AAAA,QACN,MAAM,CAAC,MAAM,MAAM,IAAI;AAAA,MAAA;AAAA,IACzB;;;QAtGS,IAAG;AAAA,QAAY,OAAM;AAAA,MAAA,oJAG1B,EAAA,cAAA,uDAAA,CAAyE;oBAgBpD,WAAS,CAAlB,GAAG,MAAC;4EAIgB,IAAC,IAAA,CAAA,IAAA,uDAAA,CAAA,kIAKgCC,eAAA,EAAA,YAAA,qCAAA,EAAE,IAAI,wBAAA,CAAA,sJAIKD,eAAA,EAAE,IAAI,yDACxBA,eAAA,EAAE,GAAG,oDAEnBA,eAAA,EAAE,KAAK,0DACOA,eAAA,EAAE,IAAI;sBAG1C,EAAE,MAAI,CAAX,MAAC;kIAIL,CAAC,CAAA,SAAA;AAAA;;;;;;;;;;;;;;;;;ACNpB,UAAM,aAAa;AAAA,MACjB;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,QACN,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,MAAM;AAAA,QACN,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,IACR;;AApES,YAAA,WAAAL,eAAAC,WAAA,EAAA,OAAM,oBAAgB,MAAA,CAAA,CAAA,2aAAA;oBAcN,YAAU,CAAnB,GAAG,MAAC;4EAIgB,IAAC,IAAA,CAAA,IAAA,wBAAA,CAAA,sIAItBI,eAAA,EAAE,IAAI,wCAEsBA,eAAA,EAAE,KAAK,gEAEUA,eAAA,EAAE,IAAI;AAC/C,YAAA,EAAE,MAAI;AACZ,gBAAA,wDAAAA,eAAA,EAAE,IAAI,CAAA,QAAA;AAAA;;;;;;;;;;;;;;;;;;;ACIrB,UAAM,WAAW;AAAA,MACf,EAAE,MAAM,UAAU,MAAM,QAAQ,MAAM,MAAM,IAAI,2BAAA;AAAA,MAChD,EAAE,MAAM,UAAU,MAAM,QAAQ,MAAM,MAAM,IAAI,0BAAA;AAAA,MAChD,EAAE,MAAM,gBAAgB,MAAM,QAAQ,MAAM,MAAM,IAAI,2BAAA;AAAA,MACtD,EAAE,MAAM,SAAS,MAAM,SAAS,MAAM,MAAM,IAAI,yBAAA;AAAA,IAAyB;;AApChE,YAAA,WAAAL,eAAAC,WAAA,EAAA,OAAM,oBAAgB,MAAA,CAAA,CAAA,+YAAA;oBAUH,UAAQ,CAAjB,GAAG,MAAC;6OAGSK,eAAA,EAAA,YAAA,EAAE,IAAE,MAEvBD,eAAA,EAAE,IAAI,kFAGNA,eAAA,EAAE,IAAI,6CAE2BA,eAAA,EAAE,IAAI;;;;;;;;;;;;;;mBCpB3CL,eAAAC,WAAA,EAAA,OAAM,iCAAgC,GAAA,MAAA,CAAA,8KAI3C,EAAA,cAAA,uDAAA,CAAyE;;;;;;;;;;;ACJrE,QAAA,UAAAD,eAAAC,WAAA,EAAA,OAAM,mCAA+B,MAAA,CAAA,CAAA,uzCAAA;;;;;;;;;;;;;;;;;;;;;;;ACAxC,YAAA,OAAAD,eAAAC,WAAA,EAAA,OAAM,6BAAyB,MAAA,CAAA,CAAA,GAAA;;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderComponent","_unref","_ssrRenderList","_ssrInterpolate","_ssrRenderStyle"],"sources":["../../../../components/StarField.vue","../../../../components/HeroSection.vue","../../../../components/ValueSection.vue","../../../../components/PlaygroundSection.vue","../../../../composables/useCountUp.ts","../../../../components/MetricsSection.vue","../../../../components/ScenarioSection.vue","../../../../components/HighlightsSection.vue","../../../../components/TrustSection.vue","../../../../components/CtaSection.vue","../../../../components/SiteFooter.vue","../../../../pages/index.vue"],"sourcesContent":["<template>\n  <canvas\n    ref=\"canvasRef\"\n    class=\"absolute inset-0 w-full h-full\"\n    :style=\"{ pointerEvents: 'auto' }\"\n    aria-hidden=\"true\"\n  />\n</template>\n\n<script setup lang=\"ts\">\n/**\n * StarField - 沉浸式 Canvas 星空\n *\n * 特性：\n *  - 350+ 颗星粒子，双层视差（远景慢、近景快）\n *  - 鼠标移动时粒子产生轻微排斥/吸引，形成\"互动星河\"\n *  - 偶发流星划过\n *  - 自适应 DPR，高分屏不糊\n *  - requestAnimationFrame + 暂停节流（标签页不可见时）\n */\nconst canvasRef = ref<HTMLCanvasElement | null>(null);\n\nonMounted(() => {\n  const canvas = canvasRef.value;\n  if (!canvas) return;\n  const ctx = canvas.getContext('2d', { alpha: true });\n  if (!ctx) return;\n\n  let dpr = Math.min(window.devicePixelRatio || 1, 2);\n  let W = 0, H = 0;\n  let raf = 0;\n  let visible = true;\n  let mouseX = -9999, mouseY = -9999;\n\n  type Star = { x: number; y: number; z: number; r: number; a: number; vx: number; vy: number; hue: number };\n  const farStars: Star[] = [];\n  const nearStars: Star[] = [];\n\n  const rand = (min: number, max: number) => Math.random() * (max - min) + min;\n\n  const resize = () => {\n    const rect = canvas.getBoundingClientRect();\n    W = rect.width;\n    H = rect.height;\n    canvas.width = W * dpr;\n    canvas.height = H * dpr;\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  };\n\n  const buildStars = () => {\n    farStars.length = 0;\n    nearStars.length = 0;\n    const count = Math.floor((W * H) / 6500);\n    for (let i = 0; i < count; i++) {\n      farStars.push({\n        x: Math.random() * W,\n        y: Math.random() * H,\n        z: rand(0.15, 0.45),\n        r: rand(0.3, 0.9),\n        a: rand(0.2, 0.7),\n        vx: 0, vy: 0,\n        hue: rand(200, 280),\n      });\n    }\n    for (let i = 0; i < 80; i++) {\n      nearStars.push({\n        x: Math.random() * W,\n        y: Math.random() * H,\n        z: rand(0.6, 1.0),\n        r: rand(0.8, 1.8),\n        a: rand(0.4, 0.9),\n        vx: 0, vy: 0,\n        hue: rand(180, 320),\n      });\n    }\n  };\n\n  // 流星\n  type Meteor = { x: number; y: number; vx: number; vy: number; life: number; max: number };\n  const meteors: Meteor[] = [];\n  const maybeSpawnMeteor = () => {\n    if (Math.random() > 0.012) return;\n    meteors.push({\n      x: rand(-100, W * 0.4),\n      y: rand(-50, H * 0.3),\n      vx: rand(4, 7),\n      vy: rand(1.5, 3),\n      life: 0,\n      max: rand(40, 60),\n    });\n    if (meteors.length > 3) meteors.shift();\n  };\n\n  let t0 = performance.now();\n  const loop = (t: number) => {\n    if (!visible) {\n      raf = requestAnimationFrame(loop);\n      return;\n    }\n    const dt = Math.min(0.05, (t - t0) / 1000);\n    t0 = t;\n\n    // 背景渐变清屏\n    const grad = ctx.createLinearGradient(0, 0, 0, H);\n    grad.addColorStop(0, '#050516');\n    grad.addColorStop(1, '#0a0a2e');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, W, H);\n\n    // 远景星\n    for (const s of farStars) {\n      s.a += Math.sin(t * 0.001 + s.x) * 0.005;\n      const a = Math.max(0.1, Math.min(0.8, s.a));\n      ctx.beginPath();\n      ctx.fillStyle = `hsla(${s.hue}, 80%, 75%, ${a})`;\n      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);\n      ctx.fill();\n    }\n\n    // 近景星 + 鼠标交互\n    for (const s of nearStars) {\n      const dx = s.x - mouseX;\n      const dy = s.y - mouseY;\n      const dist = Math.hypot(dx, dy);\n      const force = Math.max(0, 110 - dist) / 110;\n      s.vx += dx * force * 0.02;\n      s.vy += dy * force * 0.02;\n      s.vx *= 0.92; s.vy *= 0.92;\n      s.x += s.vx;\n      s.y += s.vy;\n      s.x += s.z * 0.15; // 视差漂移\n      if (s.x > W + 5) s.x = -5;\n      if (s.x < -5) s.x = W + 5;\n      if (s.y > H + 5) s.y = -5;\n      if (s.y < -5) s.y = H + 5;\n\n      const glow = Math.max(0, 80 - dist) / 80 * 0.5;\n      ctx.beginPath();\n      ctx.fillStyle = `hsla(${s.hue}, 90%, 80%, ${s.a + glow})`;\n      ctx.arc(s.x, s.y, s.r + glow * 2, 0, Math.PI * 2);\n      ctx.fill();\n\n      if (glow > 0.05) {\n        ctx.beginPath();\n        ctx.strokeStyle = `hsla(${s.hue}, 90%, 80%, ${glow * 0.4})`;\n        ctx.lineWidth = 0.6;\n        ctx.moveTo(s.x, s.y);\n        ctx.lineTo(s.x - s.vx * 4, s.y - s.vy * 4);\n        ctx.stroke();\n      }\n    }\n\n    // 流星\n    maybeSpawnMeteor();\n    for (let i = meteors.length - 1; i >= 0; i--) {\n      const m = meteors[i];\n      m.x += m.vx; m.y += m.vy; m.life++;\n      const alpha = 1 - m.life / m.max;\n      const tail = 60;\n      const grd = ctx.createLinearGradient(m.x, m.y, m.x - m.vx * tail / 5, m.y - m.vy * tail / 5);\n      grd.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);\n      grd.addColorStop(1, 'rgba(255, 255, 255, 0)');\n      ctx.strokeStyle = grd;\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      ctx.moveTo(m.x, m.y);\n      ctx.lineTo(m.x - m.vx * tail / 5, m.y - m.vy * tail / 5);\n      ctx.stroke();\n      if (m.life > m.max) meteors.splice(i, 1);\n    }\n\n    raf = requestAnimationFrame(loop);\n  };\n\n  const onMove = (e: MouseEvent) => {\n    const rect = canvas.getBoundingClientRect();\n    mouseX = e.clientX - rect.left;\n    mouseY = e.clientY - rect.top;\n  };\n  const onLeave = () => { mouseX = -9999; mouseY = -9999; };\n  const onVis = () => { visible = !document.hidden; };\n\n  resize();\n  buildStars();\n  raf = requestAnimationFrame(loop);\n  window.addEventListener('resize', () => { resize(); buildStars(); });\n  window.addEventListener('mousemove', onMove, { passive: true });\n  window.addEventListener('mouseleave', onLeave);\n  document.addEventListener('visibilitychange', onVis);\n\n  onBeforeUnmount(() => {\n    cancelAnimationFrame(raf);\n    window.removeEventListener('resize', () => { resize(); buildStars(); });\n    window.removeEventListener('mousemove', onMove);\n    window.removeEventListener('mouseleave', onLeave);\n    document.removeEventListener('visibilitychange', onVis);\n  });\n});\n</script>\n","<template>\n  <section class=\"relative min-h-screen flex items-center justify-center overflow-hidden\">\n    <!-- 星空背景 -->\n    <StarField class=\"absolute inset-0\" />\n\n    <!-- 顶部装饰光晕 -->\n    <div\n      class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full opacity-30 blur-3xl pointer-events-none\"\n      style=\"background: radial-gradient(circle, rgba(102, 126, 234, 0.5) 0%, transparent 60%);\"\n    />\n\n    <div class=\"relative z-10 max-w-6xl mx-auto px-6 py-24 text-center\">\n      <!-- 顶部 tag -->\n      <div\n        data-reveal\n        class=\"fm-reveal inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur mb-8 text-sm text-white/70\"\n      >\n        <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400 fm-pulse-glow\"></span>\n        正在为 <span class=\"text-emerald-300 fm-tabular\">{{ liveEvents }}</span> 场活动提供支持\n      </div>\n\n      <!-- 主标题 -->\n      <h1\n        data-reveal\n        class=\"fm-reveal fm-reveal-delay-1 text-6xl md:text-8xl font-bold tracking-tight leading-[1.05] mb-6\"\n      >\n        <span class=\"fm-text-gradient-rainbow\">聚闪耀</span>\n        <span class=\"text-white/90 ml-3\">FlashMeet</span>\n      </h1>\n\n      <!-- 副标题 -->\n      <p\n        data-reveal\n        class=\"fm-reveal fm-reveal-delay-2 text-xl md:text-2xl text-white/60 mb-3\"\n      >\n        计算相遇的概率，渲染心动的瞬间\n      </p>\n      <p\n        data-reveal\n        class=\"fm-reveal fm-reveal-delay-3 text-base md:text-lg text-white/40 max-w-2xl mx-auto mb-12\"\n      >\n        线下聚会互动大屏系统：扫码签到、星系上墙、实时互动游戏、智能匹配。\n        <br class=\"hidden md:block\" />\n        让 30 秒破冰不再只是传说，让每一场聚会都闪耀。\n      </p>\n\n      <!-- CTA -->\n      <div\n        data-reveal\n        class=\"fm-reveal fm-reveal-delay-4 flex flex-col sm:flex-row gap-4 justify-center items-center\"\n      >\n        <a class=\"fm-btn fm-btn-primary\" href=\"#playground\">\n          立即体验 Demo\n          <span class=\"ml-2\">→</span>\n        </a>\n        <a class=\"fm-btn fm-btn-ghost\" href=\"#scenarios\">\n          了解应用场景\n        </a>\n      </div>\n\n      <!-- 实时数据条 -->\n      <div\n        data-reveal\n        class=\"fm-reveal fm-reveal-delay-4 mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-12 text-left\"\n      >\n        <div v-for=\"m in quickStats\" :key=\"m.label\" class=\"border-l border-white/10 pl-4\">\n          <div class=\"text-2xl md:text-3xl font-bold fm-text-gradient fm-tabular\">\n            {{ m.value }}\n          </div>\n          <div class=\"text-xs text-white/40 mt-1\">{{ m.label }}</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 向下滚动提示 -->\n    <div class=\"absolute bottom-8 left-1/2 -translate-x-1/2 text-white/30 text-sm flex flex-col items-center gap-2 animate-bounce\">\n      <span>向下探索</span>\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path d=\"M7 13l5 5 5-5M7 6l5 5 5-5\" />\n      </svg>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\n// 实时\"活动数\" 浮点模拟（带轻微随机游走）\nconst liveEvents = ref(38);\nlet timer: ReturnType<typeof setInterval> | null = null;\nonMounted(() => {\n  timer = setInterval(() => {\n    const next = liveEvents.value + (Math.random() > 0.5 ? 1 : -1);\n    liveEvents.value = Math.max(20, Math.min(80, next));\n  }, 4200);\n});\nonBeforeUnmount(() => { if (timer) clearInterval(timer); });\n\nconst quickStats = [\n  { value: '30s', label: '扫码即用' },\n  { value: '10K+', label: '并发互动' },\n  { value: '50+', label: '覆盖城市' },\n  { value: '4.9/5', label: '用户评分' },\n];\n</script>\n","<template>\n  <section class=\"relative py-32\">\n    <div class=\"max-w-6xl mx-auto px-6\">\n      <div data-reveal class=\"fm-reveal text-center mb-20\">\n        <p class=\"text-sm text-white/40 tracking-[0.3em] uppercase mb-4\">Why FlashMeet</p>\n        <h2 class=\"text-5xl md:text-6xl font-bold mb-6\">\n          为什么主办方选择 <span class=\"fm-text-gradient\">我们</span>\n        </h2>\n        <p class=\"text-white/50 text-lg max-w-2xl mx-auto\">\n          不止是娱乐工具，更是用户增长与社交资产沉淀的操作系统。\n        </p>\n      </div>\n\n      <div class=\"grid md:grid-cols-3 gap-6\">\n        <div\n          v-for=\"(v, i) in values\"\n          :key=\"v.title\"\n          data-reveal\n          class=\"fm-reveal fm-glass p-8 group\"\n          :class=\"`fm-reveal-delay-${i + 1}`\"\n        >\n          <!-- 数字序号 -->\n          <div class=\"text-xs text-white/30 fm-tabular mb-4\">0{{ i + 1 }}</div>\n          <!-- 大图标 -->\n          <div\n            class=\"w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-6 transition-transform group-hover:scale-110 group-hover:rotate-3\"\n            :style=\"{\n              background: v.bg,\n              boxShadow: '0 8px 24px -8px rgba(0,0,0,0.4)',\n            }\"\n          >\n            {{ v.icon }}\n          </div>\n          <h3 class=\"text-2xl font-bold mb-3\">{{ v.title }}</h3>\n          <p class=\"text-white/55 leading-relaxed mb-6\">{{ v.desc }}</p>\n          <ul class=\"space-y-2\">\n            <li v-for=\"b in v.bullets\" :key=\"b\" class=\"flex items-start gap-2 text-sm text-white/60\">\n              <span class=\"text-emerald-400 mt-0.5\">✓</span>\n              <span>{{ b }}</span>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nconst values = [\n  {\n    icon: '⚡',\n    title: '打破尴尬',\n    desc: '30 秒破冰不再是传说。我们用游戏化机制把\"破冰\"从心理门槛变成视觉冲击。',\n    bg: 'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)',\n    bullets: [\n      '扫码即参与，零下载',\n      '渐进式画像，越玩越懂你',\n      '大屏视觉冲击，让冷场变爆点',\n    ],\n  },\n  {\n    icon: '🚀',\n    title: '激活参与',\n    desc: '从\"低头族\"到\"全场焦点\"。让每一个参与者都有戏，让主持人不再尬场。',\n    bg: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',\n    bullets: [\n      '万人并发不卡',\n      '实时排行，激发竞争心',\n      '副场控无缝接管，不怕断网',\n    ],\n  },\n  {\n    icon: '💎',\n    title: '沉淀资产',\n    desc: '不只是娱乐，更是用户画像与社交关系。活动结束，资产留得住。',\n    bg: 'linear-gradient(135deg, #4fc3f7 0%, #66bb6a 100%)',\n    bullets: [\n      '数字成就卡裂变传播',\n      '延时社交池，活动后仍可破冰',\n      '复盘数据看板，量化活动 ROI',\n    ],\n  },\n];\n</script>\n","<template>\n  <section id=\"playground\" class=\"relative py-32 overflow-hidden\">\n    <!-- 背景装饰 -->\n    <div\n      class=\"absolute top-1/4 right-0 w-[500px] h-[500px] rounded-full blur-3xl opacity-20 pointer-events-none\"\n      style=\"background: radial-gradient(circle, #764ba2 0%, transparent 60%);\"\n    />\n\n    <div class=\"max-w-6xl mx-auto px-6\">\n      <div data-reveal class=\"fm-reveal text-center mb-20\">\n        <p class=\"text-sm text-white/40 tracking-[0.3em] uppercase mb-4\">Core Playgrounds</p>\n        <h2 class=\"text-5xl md:text-6xl font-bold mb-6\">\n          <span class=\"fm-text-gradient\">四大核心玩法</span>\n        </h2>\n        <p class=\"text-white/50 text-lg max-w-2xl mx-auto\">\n          点击下方任意一个 demo，立即体验。每一个都已经在数千场真实活动中跑通。\n        </p>\n      </div>\n\n      <div class=\"grid md:grid-cols-2 gap-6\">\n        <!-- 抽奖 Demo -->\n        <div\n          data-reveal\n          class=\"fm-reveal fm-glass p-8 cursor-pointer\"\n          @click=\"drawLottery\"\n        >\n          <div class=\"flex items-center gap-3 mb-4\">\n            <span class=\"text-3xl\">🎰</span>\n            <h3 class=\"text-xl font-bold\">互动抽奖</h3>\n          </div>\n          <p class=\"text-white/50 text-sm mb-6\">原子性库存扣减，防超发防刷票。手机震动反馈，大屏实时滚动。</p>\n          <!-- 抽奖舞台 -->\n          <div class=\"relative h-32 rounded-xl overflow-hidden bg-gradient-to-br from-purple-900/40 to-pink-900/40 border border-white/5 flex items-center justify-center\">\n            <transition name=\"lottery\">\n              <div\n                v-if=\"lotteryWinner\"\n                :key=\"lotteryKey\"\n                class=\"text-3xl font-bold fm-text-gradient-rainbow\"\n              >\n                {{ lotteryWinner }}\n              </div>\n              <div v-else class=\"text-white/40 text-sm\">{{ lotteryHint }}</div>\n            </transition>\n          </div>\n          <button\n            class=\"mt-4 w-full py-2 rounded-lg text-sm font-semibold transition\"\n            :class=\"lotterySpinning\n              ? 'bg-white/5 text-white/40 cursor-not-allowed'\n              : 'bg-gradient-to-r from-purple-500 to-pink-500 hover:opacity-90 text-white'\"\n            :disabled=\"lotterySpinning\"\n          >\n            {{ lotterySpinning ? '抽奖中…' : '点我抽一次' }}\n          </button>\n        </div>\n\n        <!-- 摇一摇 Demo -->\n        <div\n          data-reveal\n          class=\"fm-reveal fm-reveal-delay-1 fm-glass p-8 cursor-pointer\"\n          @click=\"addShake\"\n        >\n          <div class=\"flex items-center gap-3 mb-4\">\n            <span class=\"text-3xl\">📱</span>\n            <h3 class=\"text-xl font-bold\">摇一摇大赛</h3>\n          </div>\n          <p class=\"text-white/50 text-sm mb-6\">全场同频竞技，500ms 实时排行。突破社交冷场，瞬间点燃全场。</p>\n          <!-- 摇一摇分 -->\n          <div class=\"relative h-32 rounded-xl overflow-hidden bg-gradient-to-br from-cyan-900/40 to-emerald-900/40 border border-white/5 flex flex-col items-center justify-center\">\n            <div class=\"text-5xl font-bold fm-text-gradient-cool fm-tabular\">\n              {{ shakeScore }}\n            </div>\n            <div class=\"text-white/40 text-xs mt-2\">点击累积分数（模拟加速度计）</div>\n          </div>\n          <button\n            class=\"mt-4 w-full py-2 rounded-lg text-sm font-semibold transition bg-gradient-to-r from-cyan-500 to-emerald-500 hover:opacity-90 text-white\"\n          >\n            点击摇一下\n          </button>\n        </div>\n\n        <!-- 匹配 Demo -->\n        <div\n          data-reveal\n          class=\"fm-reveal fm-reveal-delay-2 fm-glass p-8 cursor-pointer\"\n          @click=\"startMatch\"\n        >\n          <div class=\"flex items-center gap-3 mb-4\">\n            <span class=\"text-3xl\">💫</span>\n            <h3 class=\"text-xl font-bold\">CP 盲盒匹配</h3>\n          </div>\n          <p class=\"text-white/50 text-sm mb-6\">基于标签雷达的智能匹配，双盲破冰保护隐私。</p>\n          <!-- 匹配动效 -->\n          <div class=\"relative h-32 rounded-xl overflow-hidden bg-gradient-to-br from-rose-900/40 to-orange-900/40 border border-white/5 flex items-center justify-center\">\n            <div class=\"flex items-center gap-4\">\n              <div\n                class=\"w-16 h-16 rounded-full flex items-center justify-center text-2xl transition-all duration-700\"\n                :class=\"matchMatched ? 'bg-rose-500/30' : 'bg-white/10'\"\n                :style=\"matchStyle.left\"\n              >\n                👩\n              </div>\n              <transition name=\"heart\">\n                <div v-if=\"matchMatched\" class=\"text-rose-400 text-2xl\">💕</div>\n              </transition>\n              <div\n                class=\"w-16 h-16 rounded-full flex items-center justify-center text-2xl transition-all duration-700\"\n                :class=\"matchMatched ? 'bg-rose-500/30' : 'bg-white/10'\"\n                :style=\"matchStyle.right\"\n              >\n                🧑\n              </div>\n            </div>\n          </div>\n          <button\n            class=\"mt-4 w-full py-2 rounded-lg text-sm font-semibold transition\"\n            :class=\"matching\n              ? 'bg-white/5 text-white/40 cursor-not-allowed'\n              : 'bg-gradient-to-r from-rose-500 to-orange-500 hover:opacity-90 text-white'\"\n            :disabled=\"matching\"\n          >\n            {{ matching ? '匹配中…' : matchMatched ? '再来一组' : '开始匹配' }}\n          </button>\n        </div>\n\n        <!-- 签到 Demo -->\n        <div\n          data-reveal\n          class=\"fm-reveal fm-reveal-delay-3 fm-glass p-8 cursor-pointer\"\n          @click=\"addSignin\"\n        >\n          <div class=\"flex items-center gap-3 mb-4\">\n            <span class=\"text-3xl\">🌌</span>\n            <h3 class=\"text-xl font-bold\">星系签到</h3>\n          </div>\n          <p class=\"text-white/50 text-sm mb-6\">扫码秒级上墙，化作暗星飞入星系。渐进式画像游戏化收集标签。</p>\n          <!-- 星系 -->\n          <div class=\"relative h-32 rounded-xl overflow-hidden bg-gradient-to-br from-indigo-900/60 to-violet-900/60 border border-white/5\">\n            <div\n              v-for=\"(p, i) in signinDots\"\n              :key=\"i\"\n              class=\"absolute w-2 h-2 rounded-full bg-cyan-300\"\n              :style=\"{\n                left: `${p.x}%`,\n                top: `${p.y}%`,\n                opacity: p.o,\n                transform: `scale(${p.s})`,\n                transition: 'all 0.4s',\n                boxShadow: '0 0 8px rgba(79, 195, 247, 0.8)',\n              }\"\n            />\n            <div class=\"absolute bottom-2 right-3 text-xs text-white/40\">\n              {{ signinDots.length }} 颗星已点亮\n            </div>\n          </div>\n          <button\n            class=\"mt-4 w-full py-2 rounded-lg text-sm font-semibold transition bg-gradient-to-r from-indigo-500 to-violet-500 hover:opacity-90 text-white\"\n          >\n            点亮我的星\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\n// ===== 抽奖 =====\nconst participants = ['林深时见鹿', '海蓝时见鲸', 'Moonlight', '小狐狸', '星河', 'Lucky🐱', 'Echo', '奥利奥', '七月', '南风'];\nconst lotteryWinner = ref<string | null>(null);\nconst lotterySpinning = ref(false);\nconst lotteryHint = ref('点击下方按钮抽一次');\nconst lotteryKey = ref(0);\nconst drawLottery = () => {\n  if (lotterySpinning.value) return;\n  lotterySpinning.value = true;\n  lotteryHint.value = '抽奖中…';\n  let ticks = 0;\n  const id = setInterval(() => {\n    lotteryWinner.value = participants[Math.floor(Math.random() * participants.length)];\n    lotteryKey.value++;\n    ticks++;\n    if (ticks > 10) {\n      clearInterval(id);\n      lotterySpinning.value = false;\n    }\n  }, 80);\n};\n\n// ===== 摇一摇 =====\nconst shakeScore = ref(0);\nconst addShake = () => {\n  const inc = 5 + Math.floor(Math.random() * 15);\n  shakeScore.value += inc;\n  if ('vibrate' in navigator) navigator.vibrate(20);\n};\n\n// ===== 匹配 =====\nconst matching = ref(false);\nconst matchMatched = ref(false);\nconst matchStyle = reactive({ left: '', right: '' });\nconst startMatch = () => {\n  if (matching.value) return;\n  matchMatched.value = false;\n  matchStyle.left = 'transform: translateX(-40px);';\n  matchStyle.right = 'transform: translateX(40px);';\n  matching.value = true;\n  setTimeout(() => {\n    matchStyle.left = '';\n    matchStyle.right = '';\n    matchMatched.value = true;\n    matching.value = false;\n  }, 1200);\n};\n\n// ===== 签到 =====\nconst signinDots = ref<{ x: number; y: number; o: number; s: number }[]>([]);\nconst addSignin = () => {\n  signinDots.value.push({\n    x: 10 + Math.random() * 80,\n    y: 10 + Math.random() * 70,\n    o: 0,\n    s: 0.5,\n  });\n  setTimeout(() => {\n    const last = signinDots.value[signinDots.value.length - 1];\n    if (last) {\n      last.o = 1;\n      last.s = 1.2 + Math.random() * 0.8;\n    }\n  }, 30);\n  if (signinDots.value.length > 30) signinDots.value.shift();\n};\n</script>\n\n<style scoped>\n.lottery-enter-active, .lottery-leave-active { transition: all 0.1s; }\n.lottery-enter-from { opacity: 0; transform: translateY(20px) scale(0.8); }\n.lottery-leave-to { opacity: 0; transform: translateY(-20px) scale(0.8); }\n.heart-enter-active { transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); }\n.heart-enter-from { opacity: 0; transform: scale(0); }\n</style>\n","/**\n * useCountUp - 数字从 0 滚到目标值（视口可见时启动）\n *\n * 用法：\n *   const v = useCountUp(() => 1200)\n *   <span data-countup>{{ v }}</span>\n */\nexport function useCountUp(\n  getTarget: () => number,\n  durationMs = 1800,\n) {\n  const value = ref(0);\n  if (import.meta.server) return value;\n\n  let raf = 0;\n  let started = false;\n\n  const start = () => {\n    if (started) return;\n    started = true;\n    const target = getTarget();\n    const t0 = performance.now();\n    const tick = (now: number) => {\n      const p = Math.min(1, (now - t0) / durationMs);\n      const eased = 1 - Math.pow(1 - p, 3);\n      value.value = Math.floor(eased * target);\n      if (p < 1) raf = requestAnimationFrame(tick);\n      else value.value = target;\n    };\n    raf = requestAnimationFrame(tick);\n  };\n\n  onMounted(() => {\n    // 找到第一个 [data-countup] 元素\n    const node = document.querySelector('[data-countup]');\n    if (!node) {\n      start();\n      return;\n    }\n    const io = new IntersectionObserver(\n      (entries) => {\n        for (const e of entries) {\n          if (e.isIntersecting) {\n            start();\n            io.disconnect();\n            break;\n          }\n        }\n      },\n      { threshold: 0.3 },\n    );\n    io.observe(node);\n    onBeforeUnmount(() => {\n      io.disconnect();\n      cancelAnimationFrame(raf);\n    });\n  });\n\n  return value;\n}\n","<template>\n  <section class=\"relative py-32\">\n    <div class=\"max-w-6xl mx-auto px-6\">\n      <div data-reveal class=\"fm-reveal text-center mb-20\">\n        <p class=\"text-sm text-white/40 tracking-[0.3em] uppercase mb-4\">By the Numbers</p>\n        <h2 class=\"text-5xl md:text-6xl font-bold mb-6\">\n          数据 <span class=\"fm-text-gradient-cool\">不说谎</span>\n        </h2>\n        <p class=\"text-white/50 text-lg max-w-2xl mx-auto\">\n          从内测到生产环境，每一个数字都来自真实运行。\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-6\" data-countup>\n        <div\n          v-for=\"(m, i) in metrics\"\n          :key=\"m.label\"\n          data-reveal\n          class=\"fm-reveal fm-glass p-6 text-center\"\n          :class=\"`fm-reveal-delay-${(i % 4) + 1}`\"\n        >\n          <div class=\"text-4xl md:text-5xl font-bold fm-text-gradient fm-tabular mb-2\">\n            {{ displayValue(m, i) }}{{ m.suffix }}\n          </div>\n          <div class=\"text-sm text-white/55\">{{ m.label }}</div>\n          <div class=\"text-xs text-white/30 mt-2\">{{ m.note }}</div>\n        </div>\n      </div>\n\n      <!-- 性能指标条 -->\n      <div data-reveal class=\"fm-reveal mt-16 fm-glass p-8\">\n        <h3 class=\"text-lg font-bold mb-6 text-white/80\">⚡ 性能基线（生产环境）</h3>\n        <div class=\"space-y-5\">\n          <div v-for=\"bar in perfBars\" :key=\"bar.label\">\n            <div class=\"flex justify-between text-sm mb-2\">\n              <span class=\"text-white/70\">{{ bar.label }}</span>\n              <span class=\"text-white/90 fm-tabular font-semibold\">{{ bar.value }}</span>\n            </div>\n            <div class=\"h-2 rounded-full bg-white/5 overflow-hidden\">\n              <div\n                class=\"h-full rounded-full transition-all duration-1000\"\n                :style=\"{\n                  width: bar.w + '%',\n                  background: bar.color,\n                  boxShadow: `0 0 12px ${bar.color}`,\n                }\"\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\ntype Metric = { value: number; suffix: string; label: string; note: string };\nconst metrics: Metric[] = [\n  { value: 1280, suffix: '+', label: '累计活动场次', note: '覆盖 50+ 城市' },\n  { value: 48, suffix: 'K+', label: '累计签到用户', note: '内测期数据' },\n  { value: 10000, suffix: '+', label: '单场并发互动', note: 'WebSocket 压测峰值' },\n  { value: 99, suffix: '%', label: '签到成功率', note: '弱网 5s 兜底' },\n];\n\n// 让每个数字走自己的 useCountUp（通过 ref 注入）\nconst m0 = useCountUp(() => metrics[0].value);\nconst m1 = useCountUp(() => metrics[1].value);\nconst m2 = useCountUp(() => metrics[2].value);\nconst m3 = useCountUp(() => metrics[3].value);\nconst live = [m0, m1, m2, m3];\n\nconst displayValue = (_: Metric, i: number) => {\n  const v = live[i].value;\n  if (v >= 1000) return v.toLocaleString();\n  return v;\n};\n\nconst perfBars = [\n  { label: '签到响应 P99', value: '< 80ms', w: 92, color: 'linear-gradient(90deg, #66bb6a, #4fc3f7)' },\n  { label: 'WebSocket 消息延迟', value: '< 120ms', w: 88, color: 'linear-gradient(90deg, #4fc3f7, #667eea)' },\n  { label: '抽奖并发吞吐', value: '5K QPS', w: 96, color: 'linear-gradient(90deg, #667eea, #764ba2)' },\n  { label: '大屏 FPS（3D 模式）', value: '60 FPS', w: 100, color: 'linear-gradient(90deg, #764ba2, #f093fb)' },\n];\n</script>\n","<template>\n  <section id=\"scenarios\" class=\"relative py-32 overflow-hidden\">\n    <div\n      class=\"absolute bottom-0 left-0 w-[600px] h-[600px] rounded-full blur-3xl opacity-15 pointer-events-none\"\n      style=\"background: radial-gradient(circle, #ff6b6b 0%, transparent 60%);\"\n    />\n\n    <div class=\"max-w-6xl mx-auto px-6\">\n      <div data-reveal class=\"fm-reveal text-center mb-20\">\n        <p class=\"text-sm text-white/40 tracking-[0.3em] uppercase mb-4\">Scenarios</p>\n        <h2 class=\"text-5xl md:text-6xl font-bold mb-6\">\n          <span class=\"fm-text-gradient-warm\">六大落地场景</span>\n        </h2>\n        <p class=\"text-white/50 text-lg max-w-2xl mx-auto\">\n          从校园迎新到企业团建，从行业沙龙到私人派对，每一场聚会都能被重新定义。\n        </p>\n      </div>\n\n      <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        <div\n          v-for=\"(s, i) in scenarios\"\n          :key=\"s.title\"\n          data-reveal\n          class=\"fm-reveal fm-glass p-7 group relative overflow-hidden\"\n          :class=\"`fm-reveal-delay-${(i % 4) + 1}`\"\n        >\n          <!-- hover 光晕 -->\n          <div\n            class=\"absolute -inset-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none\"\n            :style=\"{ background: `radial-gradient(circle at 50% 0%, ${s.glow} 0%, transparent 70%)` }\"\n          />\n          <div class=\"relative\">\n            <div class=\"flex items-start justify-between mb-4\">\n              <div class=\"text-5xl group-hover:scale-110 transition-transform\">{{ s.icon }}</div>\n              <span class=\"text-xs text-white/30 fm-tabular\">{{ s.tag }}</span>\n            </div>\n            <h3 class=\"text-xl font-bold mb-2\">{{ s.title }}</h3>\n            <p class=\"text-white/50 text-sm leading-relaxed\">{{ s.desc }}</p>\n            <div class=\"mt-5 flex flex-wrap gap-2\">\n              <span\n                v-for=\"t in s.tags\"\n                :key=\"t\"\n                class=\"px-2.5 py-0.5 rounded-full text-xs bg-white/5 text-white/60 border border-white/5\"\n              >\n                {{ t }}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nconst scenarios = [\n  {\n    icon: '🎓',\n    title: '校园迎新',\n    desc: '让新生不再社恐，从入学的第一晚就找到归属感。',\n    tag: 'Edu',\n    glow: 'rgba(102, 126, 234, 0.4)',\n    tags: ['破冰', '破圈', '校园'],\n  },\n  {\n    icon: '🏢',\n    title: '企业团建',\n    desc: '让 HR 头疼的破冰游戏终于有解，团建效果可量化。',\n    tag: 'Corp',\n    glow: 'rgba(102, 126, 234, 0.4)',\n    tags: ['破冰', '数据', 'ROI'],\n  },\n  {\n    icon: '💼',\n    title: '行业峰会',\n    desc: '精准人脉匹配，让\"加微信\"变成\"聊得来\"。',\n    tag: 'Biz',\n    glow: 'rgba(79, 195, 247, 0.4)',\n    tags: ['匹配', '人脉', '沉淀'],\n  },\n  {\n    icon: '🎉',\n    title: '私人派对',\n    desc: '让派对燃到爆，宾客参与度拉满，朋友圈素材管够。',\n    tag: 'Party',\n    glow: 'rgba(255, 107, 107, 0.4)',\n    tags: ['娱乐', '氛围', '传播'],\n  },\n  {\n    icon: '🛍️',\n    title: '商场开业',\n    desc: '吸睛引流转化一体，把路人变成粉丝。',\n    tag: 'Retail',\n    glow: 'rgba(255, 215, 0, 0.4)',\n    tags: ['引流', '转化', '品牌'],\n  },\n  {\n    icon: '💒',\n    title: '婚礼互动',\n    desc: '宾客不再只顾低头吃饭，参与感拉满，祝福更走心。',\n    tag: 'Wedding',\n    glow: 'rgba(240, 147, 251, 0.4)',\n    tags: ['祝福', '互动', '温情'],\n  },\n];\n</script>\n","<template>\n  <section class=\"relative py-32\">\n    <div class=\"max-w-6xl mx-auto px-6\">\n      <div data-reveal class=\"fm-reveal text-center mb-20\">\n        <p class=\"text-sm text-white/40 tracking-[0.3em] uppercase mb-4\">Under the Hood</p>\n        <h2 class=\"text-5xl md:text-6xl font-bold mb-6\">\n          <span class=\"fm-text-gradient\">技术护城河</span>\n        </h2>\n        <p class=\"text-white/50 text-lg max-w-2xl mx-auto\">\n          不只是看起来酷炫。我们把稳定性、易用性、扩展性都做到了生产级。\n        </p>\n      </div>\n\n      <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        <div\n          v-for=\"(h, i) in highlights\"\n          :key=\"h.title\"\n          data-reveal\n          class=\"fm-reveal fm-glass p-6\"\n          :class=\"`fm-reveal-delay-${(i % 4) + 1}`\"\n        >\n          <div class=\"flex items-center gap-3 mb-3\">\n            <div class=\"w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-xl\">\n              {{ h.icon }}\n            </div>\n            <h3 class=\"text-lg font-bold\">{{ h.title }}</h3>\n          </div>\n          <p class=\"text-white/55 text-sm leading-relaxed\">{{ h.desc }}</p>\n          <div v-if=\"h.code\" class=\"mt-3 text-xs text-emerald-300 font-mono\">\n            {{ h.code }}\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nconst highlights = [\n  {\n    icon: '🚀',\n    title: '三端协同',\n    desc: 'miniapp /